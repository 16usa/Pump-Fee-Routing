# App
PORT=3000
APP_NAME=PROJECT
APP_MARK=P
APP_BASE_URL=http://localhost:3000
SEED_DEMO=false
ADMIN_TOKEN=change-me-now
WEBHOOK_SECRET=change-me-webhook

# Solana / pump.fun
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_ADDRESS=
CRANK_SECRET_KEY_JSON=
LIVE_CHAIN_TRANSACTIONS=false
READ_ONLY_MODE=true
ONCHAIN_DISCOVERY_ENABLED=true
CLAIM_WORKER_ENABLED=false
PAYOUT_WORKER_ENABLED=false
DISCOVERY_INTERVAL_MS=300000
CLAIM_INTERVAL_MS=180000
PAYOUT_INTERVAL_MS=60000
PUMP_METADATA_URL_TEMPLATE=https://frontend-api-v3.pump.fun/coins/{mint}

# Pons V2 / Robinhood Chain
# PONS_TREASURY_ADDRESS must be an EVM address you control. It receives PROJECT's
# Pons creator revenue in the Pons V2 fee escrow. Do not put a private key here.
PONS_ENABLED=true
PONS_INDEXER_ENABLED=true
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_EXPLORER_URL=https://robinhoodchain.blockscout.com
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_HOOK_ADDRESS=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
PONS_FEE_ESCROW_ADDRESS=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_TREASURY_ADDRESS=
PONS_LOG_BLOCK_RANGE=5000

# Accounting
RECIPIENT_SHARE_BPS=8000
PROTOCOL_SHARE_BPS=2000

# Payout rail: manual | http
PAYOUT_PROVIDER=manual
PAYOUT_API_URL=
PAYOUT_API_KEY=

# X OAuth (optional; only needed for verified opt-out)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional: if blank, the server derives the callback from the current HTTPS host.
# If you set this, it must exactly match the callback URL registered in your X Developer App.
X_REDIRECT_URI=
# Random 32+ byte secret used only to sign short-lived login cookies.
X_SESSION_SECRET=
# Optional and separate from OAuth login; used for server-side public X profile lookups.
X_BEARER_TOKEN=

# Exchange: disabled | kraken
EXCHANGE_PROVIDER=disabled
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_LIVE_TRADING=false
