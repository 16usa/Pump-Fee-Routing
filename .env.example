# App
PORT=3000
APP_NAME=PROJECT
APP_MARK=P
APP_BASE_URL=http://localhost:3000
SEED_DEMO=false
ADMIN_TOKEN=change-me-now
WEBHOOK_SECRET=change-me-webhook

# Solana / pump.fun
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_ADDRESS=
CRANK_SECRET_KEY_JSON=
LIVE_CHAIN_TRANSACTIONS=false
READ_ONLY_MODE=true
ONCHAIN_DISCOVERY_ENABLED=true
CLAIM_WORKER_ENABLED=false
PAYOUT_WORKER_ENABLED=false
DISCOVERY_INTERVAL_MS=300000
CLAIM_INTERVAL_MS=180000
PAYOUT_INTERVAL_MS=60000
PUMP_METADATA_URL_TEMPLATE=https://frontend-api-v3.pump.fun/coins/{mint}

# Accounting
RECIPIENT_SHARE_BPS=8000
PROTOCOL_SHARE_BPS=2000

# Payout rail: manual | http
PAYOUT_PROVIDER=manual
PAYOUT_API_URL=
PAYOUT_API_KEY=

# X OAuth (optional; only needed for verified opt-out)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_BEARER_TOKEN=http://localhost:3000/api/auth/x/callback

# Exchange: disabled | kraken
EXCHANGE_PROVIDER=disabled
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_LIVE_TRADING=false
